#!/usr/bin/env bash
# koan pre-commit hook: the routine verification tier and nothing else.
#
# `tools/verify.sh` picks its own scope from the changed paths — the link audit alone for a
# Markdown-only commit, one embedded crate's slate for a library-only one, the whole workspace
# otherwise — and runs the property laws at the routine depth (64 cases). Seconds, not minutes.
#
# What this hook does NOT run is the point of the split: coverage instrumentation, the Miri
# leak/UB audit, the module-graph score, and the deep property sweep all live in the total tier,
# `tools/verify.sh --total`, which CI runs on every push to master and which you can run by hand
# before a merge. The trend logs under `observe/` are rebaselined there, by a run that measured
# them — so this hook stages nothing and a commit is just a commit.
#
# Activate once per clone:
#     git config core.hooksPath .githooks
#
# Bypass for a hotfix with `git commit --no-verify`.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

tools/verify.sh
