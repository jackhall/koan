FN (PROBE x :Number) -> Number = (x + 1)
FN (LEVELI y :Number) -> Number = (
  FN (PROBE x :Str) -> Str = (x)
  FN (LEVELII y :Number) -> Number = (
    FN (PROBE x :Str) -> Str = (x)
    PROBE y
    PROBE y
    PROBE y
    PROBE y
    PROBE y
    PROBE y
    PROBE y
    PROBE y
  )
  LEVELII y
)
PRINT (LEVELI 1)
